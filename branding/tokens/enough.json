{
  "name": "Enough / Enough Tools",
  "source": "EnoughUI src/styles/styles.css and src/lib/variants.ts",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#12151c"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#1c202b"
    },
    "ink-border": {
      "$type": "color",
      "$value": "#2a3040"
    },
    "paper": {
      "$type": "color",
      "$value": "#f4f5f8"
    },
    "card": {
      "$type": "color",
      "$value": "#fafbfc"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "hairline": {
      "$type": "color",
      "$value": "#dde1e8"
    },
    "hairline-soft": {
      "$type": "color",
      "$value": "#eef0f4"
    },
    "border-mid": {
      "$type": "color",
      "$value": "#c6ccd6"
    },
    "text-main": {
      "$type": "color",
      "$value": "#12151c"
    },
    "text-2": {
      "$type": "color",
      "$value": "#3d4553"
    },
    "text-3": {
      "$type": "color",
      "$value": "#626b7a"
    },
    "text-4": {
      "$type": "color",
      "$value": "#5e6778"
    },
    "line-soft": {
      "$type": "color",
      "$value": "#8a93a2"
    },
    "dark-text": {
      "$type": "color",
      "$value": "#fafbfc"
    },
    "dark-text-2": {
      "$type": "color",
      "$value": "#d5dae2"
    },
    "dark-text-3": {
      "$type": "color",
      "$value": "#9aa3b2"
    },
    "accent": {
      "$type": "color",
      "$value": "#3b4fe4"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "#eef0fb"
    },
    "accent-on-ink": {
      "$type": "color",
      "$value": "#7d89f0"
    },
    "ok": {
      "$type": "color",
      "$value": "#1a7f37"
    },
    "ok-on-ink": {
      "$type": "color",
      "$value": "#6fbf87"
    },
    "warn": {
      "$type": "color",
      "$value": "#8a6508"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Space Grotesk",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Libre Caslon Text",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "{font.sans}",
      "$description": "Compatibility alias; proportional typography everywhere."
    }
  },
  "interaction": {
    "hover": "ink 5% / surface",
    "hover-strong": "accent 11% / surface",
    "active": "accent 17% / surface",
    "motion": "Brief functional transitions; honor reduced motion."
  },
  "shadow": {
    "card": "0 2px 16px rgba(18, 21, 28, 0.08)",
    "pop": "5px 5px 0 #3b4fe4",
    "palette": "8px 8px 0 rgba(59, 79, 228, 0.9)"
  },
  "shape": {
    "radius": {
      "$type": "dimension",
      "$value": "0px"
    },
    "rule": {
      "$type": "dimension",
      "$value": "1px"
    },
    "icon-stroke": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "spacing": {
    "4": {
      "$type": "dimension",
      "$value": "4px"
    },
    "8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "64": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "typography": {
    "wordmark": {
      "font": "Space Grotesk",
      "weight": 650,
      "size": "48px",
      "tracking": "-2px"
    },
    "descriptor": {
      "font": "Space Grotesk",
      "weight": 400,
      "size": "48px",
      "tracking": "-2px"
    },
    "h1": {
      "font": "Libre Caslon Text",
      "weight": 400,
      "size": "44px",
      "mobile-size": "36px",
      "line-height": 1.15,
      "tracking": "-0.01em"
    },
    "h2": {
      "font": "Libre Caslon Text",
      "weight": 400,
      "size": "34px",
      "mobile-size": "28px",
      "line-height": 1.2
    },
    "h3": {
      "font": "Libre Caslon Text",
      "weight": 400,
      "size": "21px",
      "line-height": 1.25
    },
    "h4": {
      "font": "Space Grotesk",
      "weight": 600,
      "size": "16px"
    },
    "body": {
      "font": "Space Grotesk",
      "weight": 400,
      "size": "15px",
      "line-height": 1.55
    },
    "lead": {
      "font": "Space Grotesk",
      "weight": 400,
      "size": "19px",
      "line-height": 1.55
    },
    "small": {
      "font": "Space Grotesk",
      "weight": 500,
      "size": "13px",
      "line-height": 1.5
    },
    "label": {
      "font": "Space Grotesk",
      "weight": 400,
      "size": "10px",
      "tracking": "0.12em",
      "case": "uppercase"
    }
  },
  "identity": {
    "master": "enough",
    "platform": "enough tools",
    "library": "enoughUI",
    "mark": "e.",
    "mark-artboard": "64px",
    "lockup-gap": "24px",
    "minimum-clearspace": "0.5 \u00d7 tile side",
    "minimum-digital-mark": "24px",
    "minimum-digital-lockup-height": "32px",
    "favicon-exception": "16px raster included in ICO; use supplied icon without redrawing."
  }
}
