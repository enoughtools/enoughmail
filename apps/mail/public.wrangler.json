{
  "name": "open-cloud-mail-ingress",
  "main": "src/ingress.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MAIL_DIRECTORY",
        "class_name": "MailDirectory",
        "script_name": "open-cloud-mail"
      },
      {
        "name": "MAIL_ACCOUNTS",
        "class_name": "MailAccount",
        "script_name": "open-cloud-mail"
      },
      {
        "name": "MAIL_CREDENTIALS",
        "class_name": "MailCredentials",
        "script_name": "open-cloud-mail"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MAIL_BLOBS",
      "bucket_name": "open-cloud-mail-blobs"
    }
  ]
}
